# Local-dev env for chat-service, loaded by docker-compose.yml (env_file:).
# Every value is a LOCAL-DEV-ONLY placeholder (not a production secret) — it only has to MATCH the
# peer service's value on the same machine.

MONGO_CONNECTION_STRING=mongodb://w3champions:w3champions@mongodb-chat-service-local-compose:27017
# website-backend (statistic-service) container on w3c-network-local — run that repo's compose too.
STATISTIC_SERVICE_URI=http://w3champions-statistic-service-dev:80
# chat -> wb relationship calls; pair with website-backend CHAT_RELATIONSHIPS_API_SECRET.
STATISTIC_SERVICE_RELATIONSHIPS_SECRET=localdev-chat-relationships-secret
# Per-caller inbound HMAC secrets. MM and WB MUST differ (the service refuses to boot if identical).
# Pair each with the caller's CHAT_INTERNAL_API_SECRET (matchmaking / website-backend).
INTERNAL_SECRET_MM=localdev-mm-to-chat-hmac
INTERNAL_SECRET_WB=localdev-wb-to-chat-hmac
# JWT_PUBLIC_KEY intentionally omitted: the service's built-in default is the TEST
# identification-service public key, so it already validates test-issued JWTs. Set it explicitly
# only if you point identification at a different environment.
